<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · DLDS" : "DLDS — Data Leakage Detection System")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="d-flex align-items-center justify-content-between px-4" style="height:64px;border-bottom:1px solid var(--border);background:var(--bg-elevated)">
        <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
            <svg width="28" height="28" viewBox="0 0 40 40" fill="none"><path d="M20 3 L34 9 V19 C34 28 28 34 20 37 C12 34 6 28 6 19 V9 Z" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2"/><path d="M15 19 L18.5 22.5 L26 14" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <strong style="color:var(--text-primary)">DLDS</strong>
        </a>
        <div class="d-flex align-items-center gap-2">
            <a class="btn-dlds btn-dlds-outline btn-dlds-sm" asp-controller="Home" asp-action="About">About & Security</a>
            <button class="icon-btn" data-theme-toggle type="button" title="Toggle theme">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <a class="btn-dlds btn-dlds-primary btn-dlds-sm" asp-controller="Dashboard" asp-action="Index">Dashboard &rarr;</a>
            }
            else
            {
                <a class="btn-dlds btn-dlds-outline btn-dlds-sm" asp-controller="Account" asp-action="Register">Sign Up</a>
                <a class="btn-dlds btn-dlds-primary btn-dlds-sm" asp-controller="Account" asp-action="Login">Sign In</a>
            }
        </div>
    </nav>

    @RenderBody()

    <div id="toast-container"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
