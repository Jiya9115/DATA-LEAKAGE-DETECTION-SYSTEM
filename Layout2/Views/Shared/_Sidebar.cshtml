@{
    string current = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    bool isActive(string c) => string.Equals(current, c, StringComparison.OrdinalIgnoreCase);
    string cls(string c) => isActive(c) ? "sidebar-link active" : "sidebar-link";
}
<aside class="sidebar">
    <div class="sidebar-brand">
        <svg class="dlds-logo" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 3 L34 9 V19 C34 28 28 34 20 37 C12 34 6 28 6 19 V9 Z" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2"/>
            <path d="M15 19 L18.5 22.5 L26 14" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="brand-text">
            <strong>DLDS</strong>
            <span>Data Leakage Detection</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        <a class="@cls("Dashboard")" asp-controller="Dashboard" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
            <span class="sidebar-label">Overview</span>
        </a>
        <a class="@cls("Monitoring")" asp-controller="Monitoring" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="sidebar-label">Monitored Folders</span>
        </a>
        <a class="@cls("FileEvents")" asp-controller="FileEvents" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span class="sidebar-label">File Events</span>
        </a>
        <a class="@cls("Alerts")" asp-controller="Alerts" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span class="sidebar-label">Security Alerts</span>
        </a>
        <a class="@cls("RiskRules")" asp-controller="RiskRules" asp-action="Index">
