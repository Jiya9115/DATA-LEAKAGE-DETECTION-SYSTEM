@model FolderDetailsViewModel
@{
    ViewData["Title"] = $"{Model.FolderName} — Folder Details & Files";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <a asp-action="Index" class="btn-dlds btn-dlds-outline btn-dlds-sm">&larr; Back to Monitored Folders</a>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h3 class="mb-1" style="font-weight:700">@Model.FolderName</h3>
            <div class="mono small text-muted" style="word-break:break-all">@Model.FolderPath</div>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            @if (Model.IsCurrentlyWatching)
            {
                <span class="status-pill"><span class="status-dot pulse"></span> Watching Active</span>
                <form asp-action="Stop" asp-route-id="@Model.FolderId" method="post" class="d-inline">
                    <button class="btn-dlds btn-dlds-outline btn-dlds-sm" type="submit">Pause Watching</button>
                </form>
            }
            else
            {
                <span class="status-pill" style="background:var(--bg-hover);color:var(--text-muted)"><span class="status-dot"></span> Watching Paused</span>
                <form asp-action="Start" asp-route-id="@Model.FolderId" method="post" class="d-inline">
                    <button class="btn-dlds btn-dlds-primary btn-dlds-sm" type="submit">Start Watching</button>
                </form>
            }
            <a class="btn-dlds btn-dlds-outline btn-dlds-sm" asp-controller="FileEvents" asp-action="Index" asp-route-monitoredFolderId="@Model.FolderId">
                View Events (@Model.TotalEvents)
            </a>
        </div>
    </div>
</div>

@if (!Model.IsAdmin)
{
    <div class="p-2 px-3 rounded mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:var(--accent-soft);border:1px solid rgba(34, 211, 238, 0.3)">
        <div class="small">
            <span>👤 <strong>User Privacy Mode:</strong> You are viewing files uploaded by your account (<strong>@Model.CurrentUser</strong>). Other users cannot see your files.</span>
        </div>
        <span class="badge" style="background:var(--bg-elevated);color:var(--accent)">My Files Only</span>
    </div>
}
else
{
    <div class="p-2 px-3 rounded mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:rgba(245, 158, 11, 0.1);border:1px solid rgba(245, 158, 11, 0.3)">
        <div class="small">
            <span>👑 <strong>Administrator View:</strong> Showing all files uploaded by all users across the organization.</span>
        </div>
        <span class="badge" style="background:var(--bg-elevated);color:var(--risk-medium)">All Users Visible</span>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="dlds-card p-3">
            <div class="text-muted small">@(Model.IsAdmin ? "Total Files (All Users)" : "Your Uploaded Files")</div>
            <h3 class="mb-0 mt-1" style="font-weight:700;color:var(--accent)">@Model.Files.Count</h3>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dlds-card p-3">
            <div class="text-muted small">Recorded Events</div>
            <h3 class="mb-0 mt-1" style="font-weight:700">@Model.TotalEvents</h3>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dlds-card p-3">
            <div class="text-muted small">High / Critical Risk</div>
            <h3 class="mb-0 mt-1" style="font-weight:700;color:var(--risk-critical)">@Model.RiskEvents</h3>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="dlds-card p-3">
            <div class="text-muted small">Last Activity</div>
            <div class="mt-1 small text-truncate" style="font-weight:600">
                @(Model.LastMonitoredAt.HasValue ? Model.LastMonitoredAt.Value.ToString("MMM dd, HH:mm") : "None yet")
            </div>
        </div>
    </div>
</div>

<!-- Upload Section -->
<div class="dlds-card mb-4" style="border-left: 4px solid var(--accent)">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-1" style="font-weight:700">Upload Files from Your Mac</h5>
            <p class="text-muted small mb-0">Select or drop any file/folder from your Mac to upload to this monitored folder.</p>
        </div>
        <div class="small text-muted">
            <span class="badge" style="background:var(--accent-soft);color:var(--accent);font-weight:600">Automatic Risk Scoring + Audit Trail</span>
        </div>
    </div>

    <form asp-action="Upload" asp-route-id="@Model.FolderId" method="post" enctype="multipart/form-data" id="uploadForm">
        @Html.AntiForgeryToken()
        <div class="upload-dropzone p-4 text-center rounded mb-3" id="dropZone" style="border:2px dashed var(--border);background:var(--bg);cursor:pointer;transition:border-color 0.2s, background 0.2s">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 text-muted">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <div style="font-weight:600">Drag & drop files here, or click to browse from your Mac</div>
            <div class="small text-muted mt-1">Supports all document types (.xlsx, .pdf, .docx, .sql, .csv, scripts, etc.)</div>
            <div id="fileSelectionText" class="mt-2 text-info small" style="display:none"></div>
            
            <input type="file" name="files" id="fileInput" multiple style="display:none" onchange="handleFileSelected(this)" />
            <input type="file" name="files" id="folderInput" webkitdirectory directory multiple style="display:none" onchange="handleFileSelected(this)" />
        </div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex gap-2">
                <button type="button" class="btn-dlds btn-dlds-outline btn-dlds-sm" onclick="document.getElementById('fileInput').click()">
                    Browse Files...
                </button>
                <button type="button" class="btn-dlds btn-dlds-outline btn-dlds-sm" onclick="document.getElementById('folderInput').click()">
                    Browse Entire Folder...
                </button>
            </div>
            <button type="submit" class="btn-dlds btn-dlds-primary" id="uploadBtn" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="17 8 12 3 7 8"/>
                    <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                Upload & Scan Selected
            </button>
        </div>
    </form>
</div>

<!-- Files Table -->
<div class="dlds-card mb-4 p-0">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color:var(--border) !important">
        <div>
            <h5 class="mb-0" style="font-weight:700">
                @(Model.IsAdmin ? $"All Monitored Files ({Model.Files.Count})" : $"My Uploaded Files ({Model.Files.Count})")
            </h5>
            <div class="small text-muted">
                @(Model.IsAdmin ? "All files stored in this folder with uploader attribution and risk analysis" : "Files uploaded by you with risk assessment and parameters")
            </div>
        </div>
    </div>

    @if (!Model.Files.Any())
    {
        <div class="p-5 text-center">
            <div style="font-size:36px;margin-bottom:8px">📂</div>
            <h5>@(Model.IsAdmin ? "No Files in this Folder Yet" : "You Haven't Uploaded Any Files to This Folder Yet")</h5>
            <p class="text-muted small">Upload a file from your Mac using the upload section above to test data leakage detection and view all parameters.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="dlds-table">
                <thead>
                    <tr>
                        <th>File Name</th>
                        @if (Model.IsAdmin)
                        {
                            <th>Uploaded By</th>
                        }
                        <th>Path</th>
                        <th>Size</th>
                        <th>Last Modified</th>
                        <th>Latest Event</th>
                        <th>Risk Score</th>
                        <th>Risk Level</th>
                        <th>Reason / Assessment</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var file in Model.Files)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span style="font-size:18px">
                                        @if (file.Extension.Equals(".xlsx", StringComparison.OrdinalIgnoreCase) || file.Extension.Equals(".csv", StringComparison.OrdinalIgnoreCase) || file.Extension.Equals(".xls", StringComparison.OrdinalIgnoreCase))
                                        { <text>📊</text> }
                                        else if (file.Extension.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                                        { <text>📕</text> }
                                        else if (file.Extension.Equals(".sql", StringComparison.OrdinalIgnoreCase) || file.Extension.Equals(".db", StringComparison.OrdinalIgnoreCase))
                                        { <text>🗄️</text> }
                                        else if (file.Extension.Equals(".ps1", StringComparison.OrdinalIgnoreCase) || file.Extension.Equals(".sh", StringComparison.OrdinalIgnoreCase) || file.Extension.Equals(".exe", StringComparison.OrdinalIgnoreCase))
                                        { <text>⚙️</text> }
                                        else
                                        { <text>📄</text> }
                                    </span>
                                    <strong class="mono" style="font-size:13.5px">@file.FileName</strong>
                                </div>
                            </td>
                            @if (Model.IsAdmin)
                            {
                                <td>
                                    <span class="badge" style="background:var(--bg-hover);color:var(--text-secondary);font-size:12px;font-family:var(--font-mono)">
                                        👤 @file.UploadedBy
                                    </span>
                                </td>
                            }
                            <td class="mono small text-muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@file.FullPath">
                                @file.RelativePath
                            </td>
                            <td class="small mono">@file.FileSizeFormatted</td>
                            <td class="small text-muted">@file.LastModified.ToString("MMM dd, HH:mm:ss")</td>
                            <td>
                                @if (file.LatestEventType.HasValue)
                                {
                                    <partial name="_EventTypeBadge" model="file.LatestEventType.Value" />
                                }
                                else
                                {
                                    <span class="badge" style="background:var(--bg-hover);color:var(--text-muted)">Stored</span>
                                }
                            </td>
                            <td class="mono">
                                <strong>@(file.LatestRiskScore.HasValue ? file.LatestRiskScore.Value.ToString() : "—")</strong>
                            </td>
                            <td>
                                @if (file.LatestRiskLevel.HasValue)
                                {
                                    <partial name="_RiskBadge" model="file.LatestRiskLevel.Value" />
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="small text-secondary-dlds" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@file.LatestDescription">
                                @(string.IsNullOrEmpty(file.LatestDescription) ? "Routine file" : file.LatestDescription)
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a class="btn-dlds btn-dlds-outline btn-dlds-sm" asp-action="DownloadFile" asp-route-id="@Model.FolderId" asp-route-fileName="@file.FileName" title="Download">
                                        ⬇
                                    </a>
                                    @if (file.CanManage)
                                    {
                                        <button class="btn-dlds btn-dlds-outline btn-dlds-sm" data-bs-toggle="modal" data-bs-target="#modifyModal_@file.FileName.GetHashCode()" title="Modify / Edit File">
                                            ✏ Edit
                                        </button>
                                        <form asp-action="DeleteFile" asp-route-id="@Model.FolderId" asp-route-fileName="@file.FileName" method="post" class="d-inline" onsubmit="return confirm('Delete \'@file.FileName\'? This will trigger a Deletion Event, evaluate Risk, and record an Audit Log.');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn-dlds btn-dlds-danger btn-dlds-sm" type="submit" title="Delete">
                                                🗑
                                            </button>
                                        </form>
                                    }
                                </div>

                                @if (file.CanManage)
                                {
                                    <!-- Modify Modal for this file -->
                                    <div class="modal fade text-start" id="modifyModal_@file.FileName.GetHashCode()" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content" style="background:var(--bg-elevated);border:1px solid var(--border);color:var(--text-primary)">
                                                <form asp-action="ModifyFile" asp-route-id="@Model.FolderId" method="post" enctype="multipart/form-data">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="fileName" value="@file.FileName" />
                                                    <div class="modal-header" style="border-color:var(--border)">
                                                        <h5 class="modal-title">Modify File: @file.FileName</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="small text-muted">
                                                            Modifying this file will re-trigger the Risk Assessment Engine, record a <strong>Modified</strong> event, and create a <strong>FileModified</strong> audit log entry.
                                                        </p>
                                                        <div class="mb-3">
                                                            <label class="form-label-dlds">Option 1: Upload Updated Replacement File from Mac</label>
                                                            <input type="file" name="replacementFile" class="form-control-dlds" />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label-dlds">Option 2: Append Content or Edit Text</label>
                                                            <textarea name="textContent" class="form-control-dlds mono" rows="3" placeholder="Append updated data, notes, or test payloads here..."></textarea>
                                                            <div class="small text-muted mt-1">Leaving blank will automatically simulate a modification timestamp.</div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer" style="border-color:var(--border)">
                                                        <button type="button" class="btn-dlds btn-dlds-outline" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn-dlds btn-dlds-primary">Save & Record Modification</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Recent Events Section -->
@if (Model.RecentEvents.Any())
{
    <div class="dlds-card p-0">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color:var(--border) !important">
            <h5 class="mb-0" style="font-weight:700">Recent File Activity for this Folder</h5>
            <a class="small" asp-controller="FileEvents" asp-action="Index" asp-route-monitoredFolderId="@Model.FolderId">View in Explorer &rarr;</a>
        </div>
        <div class="table-scroll">
            <table class="dlds-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>File Name</th>
                        @if (Model.IsAdmin)
                        {
                            <th>User</th>
                        }
                        <th>Event</th>
                        <th>Risk Score</th>
                        <th>Risk Level</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.RecentEvents)
                    {
                        <tr style="cursor:pointer" onclick="location.href='@Url.Action("Details", "FileEvents", new { id = ev.Id })'">
                            <td class="small text-muted mono">@ev.EventTimestamp.ToString("MMM dd, HH:mm:ss")</td>
                            <td class="mono font-weight-bold">@ev.FileName</td>
                            @if (Model.IsAdmin)
                            {
                                <td class="small mono text-muted">@(string.IsNullOrEmpty(ev.UploadedBy) ? "system" : ev.UploadedBy)</td>
                            }
                            <td><partial name="_EventTypeBadge" model="ev.EventType" /></td>
                            <td class="mono font-weight-bold">@ev.RiskScore</td>
                            <td><partial name="_RiskBadge" model="ev.RiskLevel" /></td>
                            <td class="small text-secondary-dlds">@ev.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const folderInput = document.getElementById('folderInput');
    const uploadBtn = document.getElementById('uploadBtn');
    const fileSelectionText = document.getElementById('fileSelectionText');

    dropZone.addEventListener('click', (e) => {
        if (e.target !== fileInput && e.target !== folderInput) {
            fileInput.click();
        }
    });

    ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.style.borderColor = 'var(--accent)';
            dropZone.style.background = 'var(--accent-soft)';
        });
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.style.borderColor = 'var(--border)';
            dropZone.style.background = 'var(--bg)';
        });
    });

    dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
            fileInput.files = files;
            handleFileSelected(fileInput);
        }
    });

    function handleFileSelected(input) {
        if (input.files && input.files.length > 0) {
            uploadBtn.disabled = false;
            fileSelectionText.style.display = 'block';
            if (input.files.length === 1) {
                fileSelectionText.textContent = `Selected: ${input.files[0].name} (${(input.files[0].size / 1024).toFixed(1)} KB)`;
            } else {
                fileSelectionText.textContent = `Selected ${input.files.length} files to upload`;
            }
        }
    }
</script>
}
