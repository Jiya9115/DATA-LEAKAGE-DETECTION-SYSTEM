@model DLDS.Controllers.ErrorViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Something Went Wrong";
}
<div class="error-state">
    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <h4>Unable to Process Your Request</h4>
    <p class="text-muted">Something went wrong on our end. This has been logged; please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mono text-muted small">Request ID: @Model.RequestId</p>
    }
    <a class="btn-dlds btn-dlds-primary" asp-controller="Home" asp-action="Index">Return Home</a>
</div>
