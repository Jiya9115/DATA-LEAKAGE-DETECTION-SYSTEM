@model ReportPageViewModel
@{
    ViewData["Title"] = "Reports";
}
<div class="mb-4">
    <h3 class="mb-0" style="font-weight:700">Report Center</h3>
    <p class="text-muted small mb-0">Generate summaries of recorded activity over a date range.</p>
</div>

<form method="get" class="dlds-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label-dlds">Range</label>
            <select class="form-select-dlds" name="preset" onchange="document.getElementById('customRange').style.display = this.value === 'custom' ? 'flex' : 'none'">
                <option value="today" selected="@(Model.DateRangePreset == "today")">Today</option>
                <option value="last7" selected="@(Model.DateRangePreset == "last7")">Last 7 days</option>
                <option value="last30" selected="@(Model.DateRangePreset == "last30")">Last 30 days</option>
                <option value="custom" selected="@(Model.DateRangePreset == "custom")">Custom range</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2" id="customRange" style="display:@(Model.DateRangePreset == "custom" ? "flex" : "none")">
            <div class="flex-fill">
                <label class="form-label-dlds">From</label>
                <input type="date" class="form-control-dlds" name="from" value="@Model.Filter.FromUtc.ToString("yyyy-MM-dd")" />
            </div>
            <div class="flex-fill">
                <label class="form-label-dlds">To</label>
                <input type="date" class="form-control-dlds" name="to" value="@Model.Filter.ToUtc.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label-dlds">Event Type</label>
            <select class="form-select-dlds" name="eventType">
                <option value="">All</option>
                @foreach (var v in Enum.GetValues<EventType>())
                {
                    <option value="@v" selected="@(Model.Filter.EventType == v)">@v</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label-dlds">Risk Level</label>
            <select class="form-select-dlds" name="riskLevel">
                <option value="">All</option>
                @foreach (var v in Enum.GetValues<RiskLevel>())
                {
                    <option value="@v" selected="@(Model.Filter.RiskLevel == v)">@v</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label-dlds">Folder</label>
            <select class="form-select-dlds" name="monitoredFolderId">
                <option value="">All</option>
                @foreach (var f in Model.Folders)
                {
                    <option value="@f.Id" selected="@(Model.Filter.MonitoredFolderId == f.Id)">@f.FolderName</option>
                }
            </select>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn-dlds btn-dlds-primary" type="submit">Generate Report</button>
        <a class="btn-dlds btn-dlds-outline" asp-action="ExportCsv" asp-all-route-data="@(new Dictionary<string,string>{ ["preset"]=Model.DateRangePreset })">Export CSV</a>
    </div>
</form>

@if (Model.Report != null)
{
    var r = Model.Report;
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="dlds-card stat-card"><div class="stat-value">@r.TotalEvents</div><div class="stat-label">Total Events</div></div></div>
        <div class="col-md-3"><div class="dlds-card stat-card"><div class="stat-value" style="color:var(--risk-high)">@r.HighRiskEvents</div><div class="stat-label">High Risk</div></div></div>
        <div class="col-md-3"><div class="dlds-card stat-card"><div class="stat-value" style="color:var(--risk-critical)">@r.CriticalEvents</div><div class="stat-label">Critical</div></div></div>
        <div class="col-md-3"><div class="dlds-card stat-card"><div class="stat-value">@r.MonitoredFoldersInScope</div><div class="stat-label">Folders in Scope</div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="dlds-card">
                <h6>Risk Distribution</h6>
                @foreach (var kv in r.EventsByRiskLevel)
                {
                    <div class="d-flex justify-content-between small py-1"><span>@kv.Key</span><strong>@kv.Value</strong></div>
                }
                @if (!r.EventsByRiskLevel.Any()) { <p class="text-muted small mb-0">No events in this range.</p> }
            </div>
        </div>
        <div class="col-md-6">
            <div class="dlds-card">
                <h6>Top Affected Extensions</h6>
                @foreach (var kv in r.TopExtensions)
                {
                    <div class="d-flex justify-content-between small py-1"><span class="mono">@kv.Key</span><strong>@kv.Value</strong></div>
                }
                @if (!r.TopExtensions.Any()) { <p class="text-muted small mb-0">No events in this range.</p> }
            </div>
        </div>
    </div>

    <div class="dlds-card p-0">
        <div class="table-scroll">
            <table class="dlds-table">
                <thead><tr><th>File</th><th>Event</th><th>Risk</th><th>Timestamp</th></tr></thead>
                <tbody>
                @foreach (var e in r.TopEvents)
                {
                    <tr>
                        <td class="mono">@e.FileName</td>
                        <td><partial name="_EventTypeBadge" model="e.EventType" /></td>
                        <td><partial name="_RiskBadge" model="e.RiskLevel" /></td>
                        <td class="small text-muted">@e.EventTimestamp.ToString("MMM dd, HH:mm:ss")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
