@using Microsoft.AspNetCore.Mvc.Rendering
<header class="topbar">
    <div class="d-flex align-items-center gap-3">
        <button class="icon-btn d-md-none" data-sidebar-toggle-mobile type="button" aria-label="Toggle navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <input class="topbar-search" type="search" placeholder="Search events, alerts, folders..." aria-label="Global search" />
        <span class="status-pill">
            <span class="status-dot pulse"></span> MONITORING ACTIVE
        </span>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button class="icon-btn" data-theme-toggle type="button" aria-label="Toggle theme" title="Toggle light/dark mode">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a class="icon-btn" asp-controller="Alerts" asp-action="Index" title="Alerts" aria-label="Alerts">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            @if (ViewBag.UnreadCount is int c && c > 0)
            {
                <span class="notif-badge">@(c > 9 ? "9+" : c.ToString())</span>
            }
        </a>
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="dropdown">
                <button class="btn-dlds btn-dlds-outline btn-dlds-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    @(User.Identity.Name)
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-item-text text-muted small">Role: @(User.IsInRole("Administrator") ? "Administrator" : "User")</span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item">Logout</button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a class="btn-dlds btn-dlds-primary btn-dlds-sm" asp-controller="Account" asp-action="Login">Sign In</a>
        }
    </div>
</header>
