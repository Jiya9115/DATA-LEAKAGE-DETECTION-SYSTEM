@model MonitoringViewModel
@{
    ViewData["Title"] = "Monitored Folders";
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0" style="font-weight:700">Folder Monitoring</h3>
        <p class="text-muted small mb-0">Add folders for real-time FileSystemWatcher monitoring.</p>
    </div>
    <button class="btn-dlds btn-dlds-primary" data-bs-toggle="modal" data-bs-target="#addFolderModal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Folder
    </button>
</div>

@if (!Model.Folders.Any())
{
    <div class="dlds-card empty-state">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7l9-4 9 4-9 4-9-4z"/></svg>
        <h4>No Monitored Folders Yet</h4>
        <p>Add a folder to start watching it for file activity.</p>
        <button class="btn-dlds btn-dlds-primary" data-bs-toggle="modal" data-bs-target="#addFolderModal">Add Your First Folder</button>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var f in Model.Folders)
        {
            <div class="col-md-6 col-xl-4">
                <div class="dlds-card hoverable h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:20px">🛡</span>
                            <strong>@f.FolderName</strong>
                        </div>
                        @if (f.IsCurrentlyWatching)
                        {
                            <span class="status-pill"><span class="status-dot pulse"></span> Active</span>
                        }
                        else
                        {
                            <span class="status-pill" style="background:var(--bg-hover);color:var(--text-muted)"><span class="status-dot"></span> Paused</span>
                        }
                    </div>
                    <div class="mono small text-muted mb-3" style="word-break:break-all">@f.FolderPath</div>
                    @if (!f.PathExists)
                    {
                        <div class="small mb-2" style="color:var(--risk-high)">⚠ Path not found on this machine</div>
                    }
                    <div class="d-flex gap-3 mb-3 small text-muted">
                        <span><strong style="color:var(--text-primary)">@f.TotalEvents</strong> events</span>
                        <span><strong style="color:var(--risk-high)">@f.RiskEvents</strong> risk events</span>
                    </div>
                    <div class="mt-auto d-flex gap-2 flex-wrap">
                        <a class="btn-dlds btn-dlds-outline btn-dlds-sm" asp-controller="FileEvents" asp-action="Index" asp-route-monitoredFolderId="@f.Id">View</a>
                        @if (f.IsCurrentlyWatching)
                        {
                            <form asp-controller="Monitoring" asp-action="Stop" asp-route-id="@f.Id" method="post">
                                <button class="btn-dlds btn-dlds-outline btn-dlds-sm" type="submit">Pause</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Monitoring" asp-action="Start" asp-route-id="@f.Id" method="post">
                                <button class="btn-dlds btn-dlds-primary btn-dlds-sm" type="submit">Start</button>
                            </form>
                        }
                        <form asp-controller="Monitoring" asp-action="Delete" asp-route-id="@f.Id" method="post" onsubmit="return confirm('Remove this folder from monitoring? This also deletes its recorded events.');">
                            <button class="btn-dlds btn-dlds-danger btn-dlds-sm" type="submit">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="modal fade" id="addFolderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background:var(--bg-elevated);border:1px solid var(--border);color:var(--text-primary)">
            <form asp-controller="Monitoring" asp-action="Add" method="post">
                <div class="modal-header" style="border-color:var(--border)">
                    <h5 class="modal-title">Add Monitored Folder</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label-dlds">Folder Name</label>
                        <input name="FolderName" class="form-control-dlds" placeholder="Documents Security" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label-dlds">Folder Path</label>
                        <input name="FolderPath" class="form-control-dlds mono" placeholder="/Users/yourname/Documents/SensitiveData" required />
                        <div class="small text-muted mt-1">Must be a valid, existing folder path on this Mac.</div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="StartImmediately" value="true" id="startNow" checked />
                        <label class="form-check-label small" for="startNow">Start monitoring immediately</label>
                    </div>
                </div>
                <div class="modal-footer" style="border-color:var(--border)">
                    <button type="button" class="btn-dlds btn-dlds-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-dlds btn-dlds-primary">Add Folder</button>
                </div>
            </form>
        </div>
    </div>
</div>
